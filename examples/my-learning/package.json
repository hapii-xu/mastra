{
  "name": "examples-my-learning",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "description": "Minimal Mastra learning sandbox — links local workspace packages",
  "scripts": {
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "mastra:studio": "mastra studio",
    "clean": "rm -rf .mastra mastra.db mastra.db-*"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/loggers": "latest",
    "mastra": "latest",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@mastra/core": "link:../../packages/core",
      "@mastra/libsql": "link:../../stores/libsql",
      "@mastra/loggers": "link:../../packages/loggers",
      "mastra": "link:../../packages/cli"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.3"
}
